# syntax=docker/dockerfile:1.7
# Neo Music in ONE container: website (Next.js) + API (Fastify, in-memory database, no Redis)
# + Caddy in front, which gets and renews the HTTPS certificate for $DOMAIN automatically.
#
#   HTTPS (Caddy gets the certificate):
#   docker run -d -p 80:80 -p 443:443 -e DOMAIN=music.example.com \
#     -e STREAM_SIGNING_SECRET=$(openssl rand -base64 32) -v neo-data:/data ghcr.io/<owner>/neo-music
#   Behind your own nginx (plain HTTP on container port 8080):
#   docker run -d -p 127.0.0.1:3003:8080 -e PUBLIC_ORIGIN=https://music.example.com \
#     -e STREAM_SIGNING_SECRET=... -v neo-data:/data ghcr.io/<owner>/neo-music
#
# /data keeps the database (/data/db) and Caddy's certificates (/data/caddy) across restarts.
FROM caddy:2.10-alpine AS caddy

FROM node:22-bookworm-slim AS base
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH NEXT_TELEMETRY_DISABLED=1
RUN corepack enable
WORKDIR /repo

FROM base AS build
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json .npmrc tsconfig.base.json ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY packages/core/package.json packages/core/
COPY packages/provider/package.json packages/provider/
COPY packages/recs/package.json packages/recs/
COPY packages/player/package.json packages/player/
RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --frozen-lockfile --filter @zuno/api... --filter @zuno/web...
COPY packages packages
COPY apps/api apps/api
COPY apps/web apps/web
RUN pnpm --filter @zuno/api build \
 && pnpm --filter @zuno/api deploy --prod --legacy /out/api \
 && cp -r apps/api/dist /out/api/dist \
 && pnpm --filter @zuno/web build \
 && mkdir -p /out/web \
 && cp -r apps/web/.next/standalone/. /out/web/ \
 && cp -r apps/web/.next/static /out/web/apps/web/.next/static \
 && cp -r apps/web/public /out/web/apps/web/public

FROM node:22-bookworm-slim AS runtime
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 \
    DB_DRIVER=memory MEMORY_DB_DIR=/data/db \
    MUSIC_PROVIDER=youtube YT_LOCATION=US YT_LANGUAGE=en LOG_LEVEL=info \
    XDG_DATA_HOME=/data XDG_CONFIG_HOME=/data/config
RUN apt-get update && apt-get install -y --no-install-recommends tini libcap2-bin ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd -r zuno && useradd -r -g zuno -d /data zuno \
 && mkdir -p /data && chown zuno:zuno /data
COPY --from=caddy /usr/bin/caddy /usr/bin/caddy
# Let Caddy bind ports 80/443 without running as root.
RUN setcap cap_net_bind_service=+ep /usr/bin/caddy
WORKDIR /app
COPY --from=build --chown=zuno:zuno /out/api /app/api
COPY --from=build --chown=zuno:zuno /out/web /app/web
COPY infra/allinone/Caddyfile /app/Caddyfile
COPY infra/allinone/start.sh /app/start.sh
USER zuno
VOLUME ["/data"]
EXPOSE 80 443 8080
HEALTHCHECK --interval=15s --timeout=3s --start-period=30s --retries=5 CMD node -e "fetch('http://127.0.0.1:4000/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["/bin/bash", "/app/start.sh"]
