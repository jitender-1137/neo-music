# Neo Music production stack (infra/docker-compose.prod.yml) — copy to infra/.env. Never commit real values.

# Public HTTPS address of the site (also the only origin allowed to call the API).
PUBLIC_ORIGIN=https://music.example.com

# ---- Postgres ----
POSTGRES_USER=zuno
POSTGRES_PASSWORD=change-me-strong-database-password
POSTGRES_DB=zuno

# ---- API ----
# 32+ random bytes, base64: openssl rand -base64 32. The API refuses to start while it contains "change-me".
STREAM_SIGNING_SECRET=change-me-change-me-change-me-change-me
# youtube | dev
MUSIC_PROVIDER=youtube
# 2-letter country code
YT_LOCATION=US
YT_LANGUAGE=en

# ---- Backups (scripts/backup.sh, optional) ----
# COMPOSE="docker compose -f infra/docker-compose.prod.yml"
# number of daily dumps to keep
# KEEP=14
