# syntax=docker/dockerfile:1.7
FROM node:22-bookworm-slim AS base
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH
RUN corepack enable
WORKDIR /repo

FROM base AS build
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json .npmrc tsconfig.base.json ./
COPY apps/api/package.json apps/api/
COPY packages/core/package.json packages/core/
COPY packages/provider/package.json packages/provider/
COPY packages/recs/package.json packages/recs/
COPY packages/player/package.json packages/player/
RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --frozen-lockfile --filter @zuno/api...
COPY packages packages
COPY apps/api apps/api
RUN pnpm --filter @zuno/api build \
 && pnpm --filter @zuno/api deploy --prod --legacy /out \
 && cp -r apps/api/dist /out/dist

FROM node:22-bookworm-slim AS runtime
ENV NODE_ENV=production
WORKDIR /app
RUN groupadd -r zuno && useradd -r -g zuno zuno
COPY --from=build --chown=zuno:zuno /out /app
USER zuno
EXPOSE 4000
HEALTHCHECK --interval=15s --timeout=3s --retries=5 CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||4000)+'/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "--import", "./dist/telemetry.js", "dist/index.js"]
