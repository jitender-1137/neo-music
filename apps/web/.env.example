# Neo Music web app — copy to apps/web/.env.local. Never commit real values.

# Where the Next.js server reaches the API (server-side rendering + the /api rewrite).
API_ORIGIN=http://127.0.0.1:4000

# Browser cache budget for the service worker (artwork + public catalog data), in MB.
# The worker uses the smaller of this and 15% of the browser's storage quota. Production builds only.
NEXT_PUBLIC_CACHE_BUDGET_MB=250

# Optional: build output folder (the test configs use separate ones so tests don't clash with `next dev`).
# NEXT_DIST_DIR=.next

# Optional, for the Playwright end-to-end tests (they start their own API on :4100 against these).
# TEST_DATABASE_URL=postgres://zuno:zuno_dev_password@127.0.0.1:5433/zuno_test
# TEST_REDIS_URL=redis://127.0.0.1:6380/14
