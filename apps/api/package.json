{
  "name": "@zuno/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "node --import ./dist/telemetry.js dist/index.js",
    "build": "tsup",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "test:memory": "TEST_DB_DRIVER=memory vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "openapi": "tsx src/openapi.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@fastify/cookie": "11.1.3",
    "@fastify/cors": "11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/swagger": "9.9.2",
    "@fastify/swagger-ui": "6.1.2",
    "@fastify/under-pressure": "^9.2.1",
    "@node-rs/argon2": "2.2.2",
    "@opentelemetry/auto-instrumentations-node": "^0.81.2",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-metrics": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@zuno/core": "workspace:*",
    "@zuno/provider": "workspace:*",
    "@zuno/recs": "workspace:*",
    "bgutils-js": "4.0.3",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "fastify-type-provider-zod": "7.0.0",
    "ioredis": "6.0.0",
    "jsdom": "30.1.3",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "youtubei.js": "18.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "0.31.11",
    "pino-pretty": "^13.2.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "5.0.5"
  }
}
