# Copy to .env for local development. Never commit real values.
NODE_ENV=development
PORT=4000
HOST=127.0.0.1
# Comma-separated browser origins allowed to call the API (the Next.js app).
# Subdomain wildcards are allowed for phone testing over a tunnel, e.g. https://*.trycloudflare.com (dev only).
WEB_ORIGINS=http://localhost:3000
DATABASE_URL=postgres://zuno:zuno_dev_password@127.0.0.1:5433/zuno
REDIS_URL=redis://127.0.0.1:6380
# 32+ random bytes, base64. Signs stream URLs. Generate: openssl rand -base64 32
STREAM_SIGNING_SECRET=change-me-change-me-change-me-change-me
# youtube | dev   (dev = generated test tones, for tests/offline work)
MUSIC_PROVIDER=youtube
YT_LOCATION=IN
YT_LANGUAGE=en
LOG_LEVEL=info
