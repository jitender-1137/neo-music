# Neo Music API — copy to apps/api/.env for local development. Never commit real values.
# Every setting the API reads is listed here; values are dummies / local defaults.

# ---- Server ----
# development | test | production
NODE_ENV=development
PORT=4000
# 0.0.0.0 inside Docker
HOST=127.0.0.1
# Comma-separated browser origins allowed to call the API (the Next.js app).
# Subdomain wildcards are allowed for phone testing over a tunnel, e.g. https://*.trycloudflare.com (dev only).
WEB_ORIGINS=http://localhost:3000
# Trust X-Forwarded-* headers from a reverse proxy (nginx). true only behind the proxy (production).
# Accepts true/false, 1/0, yes/no, on/off.
TRUST_PROXY=false
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ---- Data stores (matches infra/docker-compose.yml for local dev) ----
DATABASE_URL=postgres://zuno:zuno_dev_password@127.0.0.1:5433/zuno
REDIS_URL=redis://127.0.0.1:6380

# ---- Security ----
# 32+ random bytes, base64. Signs stream URLs and playback tokens. Generate: openssl rand -base64 32
# The API refuses to start in production while this still contains "change-me".
STREAM_SIGNING_SECRET=change-me-change-me-change-me-change-me
# sign-in session lifetime
SESSION_TTL_DAYS=30

# ---- Music provider ----
# youtube | dev (dev = generated test tones, for tests/offline work)
MUSIC_PROVIDER=youtube
# 2-letter country code
YT_LOCATION=IN
YT_LANGUAGE=en

# ---- Background work ----
# Run the outbox worker inside the API process (dev / single node). false when a separate worker runs.
WORKER_INLINE=true

# ---- Limits (per IP, per minute, unless noted) ----
RATE_LIMIT_PER_MIN=600
AUTH_RATE_LIMIT_PER_MIN=10
PLAYBACK_TOKEN_RATE_LIMIT_PER_MIN=120
STREAM_RATE_LIMIT_PER_MIN=1500
# simultaneous upstream audio fetches per API instance
STREAM_MAX_CONCURRENCY=64

# ---- Optional ----
# Spotify link import (Web API client credentials). Leave unset to use Exportify CSV uploads instead.
# SPOTIFY_CLIENT_ID=your-spotify-client-id
# SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
# OpenTelemetry tracing. Nothing is sent anywhere unless the endpoint is set.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_SERVICE_NAME=zuno-api
